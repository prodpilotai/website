---
import demo from '../data/demo.json';

// The live demo, checked from the visitor's browser: three of the questions
// ProdPush stage 7 asks of every deployment, as one compact strip. It renders
// first from the dated capture, so it is true with no script; the script then
// asks again, live.
const at = (path: string) => demo.endpoints.find((e) => e.path === path)!;
const checks = [
	{ id: 'root', path: '/' },
	{ id: 'health', path: '/health' },
	{ id: 'api', path: '/api/v1' },
];
---

<div class="live" data-live data-base={demo.base}>
	<p class="live-title">
		<span class="label">Live demo</span>
		<a href={demo.base}>prodpilot-demo.onrender.com</a>
	</p>
	<ul class="pings">
		{
			checks.map((c) => {
				const got = at(c.path);
				const ok = got.status === 200;
				return (
					<li data-state={ok ? 'verified' : 'failed'} data-check={c.id} data-path={c.path}>
						<span class="light" aria-hidden="true" />
						<code>GET {c.path}</code>
						<span data-detail>{got.status}</span>
					</li>
				);
			})
		}
	</ul>
	<p class="live-status" data-status role="status">Captured {demo.captured}.</p>
	<button class="button" type="button" data-run>Check it now</button>
</div>

<script>
	const live = document.querySelector<HTMLElement>('[data-live]');
	if (live) {
		const base = live.dataset.base!;
		const status = live.querySelector<HTMLElement>('[data-status]')!;
		const button = live.querySelector<HTMLButtonElement>('[data-run]')!;
		const rows = [...live.querySelectorAll<HTMLElement>('[data-check]')];
		let busy = false;

		function mark(row: HTMLElement, state: string, detail: string) {
			row.dataset.state = state;
			row.querySelector<HTMLElement>('[data-detail]')!.textContent = detail;
		}

		async function ask(row: HTMLElement) {
			const started = performance.now();
			try {
				const response = await fetch(base + row.dataset.path, {
					cache: 'no-store',
					signal: AbortSignal.timeout(90_000),
				});
				const ms = Math.round(performance.now() - started);
				let ok = response.status === 200;
				if (row.dataset.check === 'health') {
					const body = await response.json().catch(() => ({}));
					ok = ok && body.status === 'ok';
				}
				if (row.dataset.check === 'api') ok = response.status !== 404 && response.status < 500;
				mark(row, ok ? 'verified' : 'failed', `${response.status}, ${ms} ms`);
				return ok;
			} catch {
				mark(row, 'failed', 'no answer');
				return false;
			}
		}

		async function run() {
			if (busy) return;
			busy = true;
			button.disabled = true;
			rows.forEach((row) => mark(row, 'checking', 'checking'));
			status.textContent = 'Checking from your browser.';
			const slow = setTimeout(() => {
				status.textContent = 'Waking the service. Render free plan services sleep when idle.';
			}, 4000);
			// The first request wakes the service; the others follow it.
			const first = await ask(rows[0]);
			const rest = await Promise.all(rows.slice(1).map(ask));
			clearTimeout(slow);
			const passed = [first, ...rest].filter(Boolean).length;
			status.textContent = `Checked just now: ${passed} of ${rows.length} answered.`;
			button.disabled = false;
			busy = false;
		}

		button.addEventListener('click', run);
		const seen = new IntersectionObserver(
			(entries) => {
				if (entries.some((e) => e.isIntersecting)) {
					seen.disconnect();
					run();
				}
			},
			{ threshold: 0.4 }
		);
		seen.observe(live);
	}
</script>
