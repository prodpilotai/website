---
import hero from '../data/hero.json';

// The hero stage: a wireframe pyramid of five tiers, one per ProdPilot layer,
// lit by a recorded run of the fix loop. Each verified fix raises the score and
// the light climbs the tiers; when the gate clears, a beam falls to the floor.
// The markup renders the end of the run, so the page is true without a script.
const bands = [
	{ from: 90, name: 'Production Ready' },
	{ from: 70, name: 'Nearly Ready' },
	{ from: 40, name: 'Needs Work' },
	{ from: 0, name: 'Not Ready' },
];
const band = (v: number) => bands.find((b) => v >= b.from)!.name;
const end = hero.end.score;
// Fixes the verifier confirmed, and rules that pass without a fix of their own
// because another fix created the file they check.
const fixed = hero.verified;
const carried = hero.steps.length - hero.verified;
---

<figure class="stage" data-stage data-state="verified">
	<canvas class="stage-canvas" data-canvas aria-hidden="true"></canvas>
	<div class="readout">
		<p class="readout-run">Recorded run: <span>{hero.sample}</span></p>
		<p class="readout-score" aria-hidden="true"><span data-score>{end}</span><span class="of">/100</span></p>
		<p class="readout-band" aria-hidden="true"><span class="dot"></span><span data-band>{band(end)}</span></p>
		<div class="readout-bar" aria-hidden="true">
			<span class="fill" data-fill style={`--at: ${end}%`}></span>
			<span class="tick" style="--at: 40%"></span>
			<span class="tick" style="--at: 70%"></span>
			<span class="tick" style="--at: 90%"></span>
		</div>
		<p class="readout-line" data-line aria-hidden="true">Gate clear. {fixed} fixes verified.</p>
		<button class="readout-replay" type="button" data-replay hidden>Replay the run</button>
	</div>
	<figcaption class="sr-only">
		A recorded ProdPilot run on the sample project {hero.sample}: the audit scored it {hero.start.score} out of 100
		with {hero.start.critical.length} critical failures. {fixed} fixes were verified one by one, {carried} more rules
		passed once other fixes created the files they check, and the project
		finished at {end}, {band(end)}, and cleared the gate.
	</figcaption>
</figure>

<script>
	import hero from '../data/hero.json';

	const root = document.querySelector<HTMLElement>('[data-stage]');
	const canvas = root?.querySelector<HTMLCanvasElement>('[data-canvas]');
	const ctx = canvas?.getContext('2d');

	if (root && canvas && ctx) {
		const scoreEl = root.querySelector<HTMLElement>('[data-score]')!;
		const bandEl = root.querySelector<HTMLElement>('[data-band]')!;
		const fillEl = root.querySelector<HTMLElement>('[data-fill]')!;
		const lineEl = root.querySelector<HTMLElement>('[data-line]')!;
		const replay = root.querySelector<HTMLButtonElement>('[data-replay]')!;
		const still = window.matchMedia('(prefers-reduced-motion: reduce)');

		const bands: [number, string][] = [
			[90, 'Production Ready'],
			[70, 'Nearly Ready'],
			[40, 'Needs Work'],
			[0, 'Not Ready'],
		];
		const bandOf = (v: number) => bands.find(([floor]) => v >= floor)![1];
		const start = hero.start.score;
		const end = hero.end.score;

		// Scene state, eased towards its target every frame.
		let score = end;
		let target = end;
		let beam = 1;
		let beamTarget = 1;
		let yaw = 0.6;

		// ---- Geometry ----------------------------------------------------
		type P = [number, number, number];
		const HEIGHT = 1.35;
		const HALF = 1;
		const FLOOR = -1.05;
		const tiers = [0, 1, 2, 3, 4].map((k) => {
			const y = (k / 5) * HEIGHT;
			const s = HALF * (1 - y / HEIGHT);
			return { k, y, s };
		});
		const square = (y: number, s: number): P[] => [
			[-s, y, -s],
			[s, y, -s],
			[s, y, s],
			[-s, y, s],
		];
		const apex: P = [0, HEIGHT, 0];

		// Dust, drifting upwards through the stage.
		const dust = Array.from({ length: 150 }, () => ({
			x: (Math.random() * 2 - 1) * 1.9,
			y: FLOOR + Math.random() * 3.1,
			z: (Math.random() * 2 - 1) * 1.9,
			v: 0.02 + Math.random() * 0.05,
			r: 0.4 + Math.random() * 1.1,
		}));

		// ---- Projection --------------------------------------------------
		let w = 0;
		let h = 0;
		let dpr = 1;
		let cx = 0;
		let cy = 0;
		let focal = 0;
		const PITCH = 0.12;
		const DIST = 6;

		function project([x, y, z]: P) {
			const cyaw = Math.cos(yaw);
			const syaw = Math.sin(yaw);
			const x1 = x * cyaw - z * syaw;
			const z1 = x * syaw + z * cyaw;
			const cp = Math.cos(PITCH);
			const sp = Math.sin(PITCH);
			const y2 = y * cp - z1 * sp;
			const z2 = y * sp + z1 * cp;
			const k = focal / (z2 + DIST);
			return { x: cx + x1 * k, y: cy - y2 * k, depth: z2 };
		}

		function size() {
			const box = canvas!.getBoundingClientRect();
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			w = box.width;
			h = box.height;
			canvas!.width = Math.round(w * dpr);
			canvas!.height = Math.round(h * dpr);
			ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
			cx = w / 2;
			// On a narrow stage the readout sits above the pyramid, not beside it.
			cy = w < 560 ? h * 0.66 : h * 0.46;
			focal = Math.min(w * 1.15, h * 1.6);
		}

		// ---- Drawing -----------------------------------------------------
		function stroke(points: P[], closed: boolean, alpha: number, width: number) {
			if (alpha <= 0.01) return;
			const pts = points.map(project);
			ctx!.beginPath();
			ctx!.moveTo(pts[0].x, pts[0].y);
			for (const p of pts.slice(1)) ctx!.lineTo(p.x, p.y);
			if (closed) ctx!.closePath();
			// A wide soft pass for the glow, then a thin bright core.
			ctx!.lineWidth = width * 5;
			ctx!.strokeStyle = `rgba(214, 160, 82, ${alpha * 0.16})`;
			ctx!.stroke();
			ctx!.lineWidth = width * 2;
			ctx!.strokeStyle = `rgba(236, 196, 128, ${alpha * 0.35})`;
			ctx!.stroke();
			ctx!.lineWidth = width;
			ctx!.strokeStyle = `rgba(255, 238, 205, ${alpha})`;
			ctx!.stroke();
		}

		function pyramid() {
			const level = score / 100;
			// Tier k lights as the score climbs through its fifth of the scale.
			for (const t of tiers) {
				const lit = Math.min(Math.max((score - t.k * 20) / 20, 0), 1);
				const alpha = 0.18 + 0.82 * lit;
				stroke(square(t.y, t.s), true, alpha, t.k === 0 ? 1.5 : 1.1);
			}
			const edges = 0.3 + 0.7 * level;
			for (const c of square(0, HALF)) stroke([c, apex], false, edges, 1.2);
		}

		function slab() {
			// The dark plinth the pyramid stands on, with a faint edge.
			const top = square(-0.04, HALF * 1.14);
			const bottom = square(-0.2, HALF * 1.14);
			ctx!.fillStyle = '#0c0b0a';
			const faces: P[][] = [
				[top[0], top[1], bottom[1], bottom[0]],
				[top[1], top[2], bottom[2], bottom[1]],
				[top[2], top[3], bottom[3], bottom[2]],
				[top[3], top[0], bottom[0], bottom[3]],
				bottom,
			];
			for (const f of faces) {
				const pts = f.map(project);
				ctx!.beginPath();
				ctx!.moveTo(pts[0].x, pts[0].y);
				for (const p of pts.slice(1)) ctx!.lineTo(p.x, p.y);
				ctx!.closePath();
				ctx!.fill();
			}
			stroke(top, true, 0.22, 1);
			stroke(bottom, true, 0.12, 1);
		}

		function light() {
			if (beam <= 0.01) return;
			// The beam: from under the plinth to the floor, then a pool of light.
			const a = project([0, -0.2, 0]);
			const b = project([0, FLOOR, 0]);
			const topW = (focal / DIST) * 0.36;
			const botW = (focal / DIST) * 0.62;
			const g = ctx!.createLinearGradient(0, a.y, 0, b.y);
			g.addColorStop(0, `rgba(255, 240, 210, ${0.55 * beam})`);
			g.addColorStop(1, `rgba(255, 214, 150, ${0.08 * beam})`);
			ctx!.fillStyle = g;
			ctx!.beginPath();
			ctx!.moveTo(a.x - topW / 2, a.y);
			ctx!.lineTo(a.x + topW / 2, a.y);
			ctx!.lineTo(b.x + botW / 2, b.y);
			ctx!.lineTo(b.x - botW / 2, b.y);
			ctx!.closePath();
			ctx!.fill();

			// Built after the transform, so the gradient sits on the pool itself.
			ctx!.save();
			ctx!.translate(b.x, b.y);
			ctx!.scale(1, 0.28);
			const pool = ctx!.createRadialGradient(0, 0, 0, 0, 0, botW * 2.4);
			pool.addColorStop(0, `rgba(255, 240, 214, ${0.85 * beam})`);
			pool.addColorStop(0.3, `rgba(236, 190, 120, ${0.3 * beam})`);
			pool.addColorStop(1, 'rgba(236, 190, 120, 0)');
			ctx!.fillStyle = pool;
			ctx!.beginPath();
			ctx!.arc(0, 0, botW * 2.4, 0, Math.PI * 2);
			ctx!.fill();
			ctx!.restore();
		}

		function specks(dt: number) {
			for (const d of dust) {
				d.y += d.v * dt;
				if (d.y > FLOOR + 3.1) d.y = FLOOR;
				const p = project([d.x, d.y, d.z]);
				const near = Math.max(0, 1 - Math.hypot(d.x, d.z) / 0.9);
				const alpha = 0.12 + 0.35 * (score / 100) + 0.45 * beam * near;
				ctx!.fillStyle = `rgba(255, 228, 180, ${Math.min(alpha, 0.9)})`;
				ctx!.beginPath();
				ctx!.arc(p.x, p.y, d.r * (focal / (p.depth + DIST)) * 0.004 + 0.3, 0, Math.PI * 2);
				ctx!.fill();
			}
		}

		function frame(dt: number) {
			score += (target - score) * Math.min(1, dt * 6);
			beam += (beamTarget - beam) * Math.min(1, dt * 2.5);
			ctx!.clearRect(0, 0, w, h);
			ctx!.globalCompositeOperation = 'lighter';
			light();
			ctx!.globalCompositeOperation = 'source-over';
			slab();
			ctx!.globalCompositeOperation = 'lighter';
			pyramid();
			specks(dt);
			ctx!.globalCompositeOperation = 'source-over';
		}

		// ---- Readout -----------------------------------------------------
		function show(value: number, line: string, state: string) {
			scoreEl.textContent = String(value);
			bandEl.textContent = bandOf(value);
			fillEl.style.setProperty('--at', `${value}%`);
			lineEl.textContent = line;
			root!.dataset.state = state;
		}

		// ---- The run -----------------------------------------------------
		let timers: number[] = [];
		const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));

		function play() {
			timers.forEach(clearTimeout);
			timers = [];
			replay.hidden = true;
			target = start;
			score = start;
			beamTarget = 0;
			beam = 0;
			show(start, `Audit: ${hero.start.critical.length} critical rules failing.`, 'failed');
			const STEP = 420;
			hero.steps.forEach((s, i) => {
				later(1200 + i * STEP, () => {
					target = s.score;
					show(s.score, s.verified ? `${s.rule} verified.` : `${s.rule} passes, its file now exists.`, 'checking');
				});
			});
			later(1200 + hero.steps.length * STEP + 500, () => {
				beamTarget = 1;
				show(end, `Gate clear. ${hero.verified} fixes verified.`, 'verified');
				replay.hidden = false;
			});
		}

		function settle() {
			timers.forEach(clearTimeout);
			timers = [];
			target = score = end;
			beamTarget = beam = 1;
			show(end, `Gate clear. ${hero.verified} fixes verified.`, 'verified');
		}

		// ---- Loop --------------------------------------------------------
		let running = false;
		let visible = false;
		let last = 0;
		function tick(now: number) {
			if (!running) return;
			const dt = Math.min((now - last) / 1000, 0.05);
			last = now;
			yaw += dt * 0.16;
			frame(dt);
			requestAnimationFrame(tick);
		}
		function run() {
			const should = visible && !document.hidden && !still.matches;
			if (should && !running) {
				running = true;
				last = performance.now();
				requestAnimationFrame(tick);
			} else if (!should) {
				running = false;
			}
		}

		size();
		new ResizeObserver(() => {
			size();
			if (!running) frame(0);
		}).observe(canvas);

		let played = false;
		new IntersectionObserver(
			(entries) => {
				visible = entries.some((e) => e.isIntersecting);
				if (visible && !played && !still.matches) {
					played = true;
					play();
				}
				run();
			},
			{ threshold: 0.2 }
		).observe(root);
		document.addEventListener('visibilitychange', run);
		still.addEventListener('change', () => {
			if (still.matches) {
				settle();
				frame(0);
			}
			run();
		});
		replay.addEventListener('click', play);

		if (still.matches) {
			settle();
			frame(0);
		}
	}
</script>
