---
import hero from '../data/hero.json';
import { box, faces, origin, tall, FLAT, IDLE, type Rule, type State } from '../lib/iso';

// The field is rendered as the run ended, so it reads correctly with no script.
// The script resets it to the start of the run and replays each verified fix.
const rules = hero.rules as Rule[];
const size = box(rules.length);
const failingAtEnd = new Set(hero.end.failing);
const skippedAtEnd = new Set(hero.end.skipped);

const endState = (id: string): State =>
	skippedAtEnd.has(id) ? 'idle' : failingAtEnd.has(id) ? 'failed' : 'verified';

// The floor: one tile under every pillar, as a flat outline.
const floor = rules.map((_, index) => {
	const at = origin(index, size.rows);
	return faces(at.x, at.y, 0).top;
});

const pillars = rules
	.map((rule, index) => {
		const at = origin(index, size.rows);
		const state = endState(rule.id);
		const h = state === 'verified' ? tall(rule.weight) : state === 'failed' ? FLAT : IDLE;
		return { rule, index, at, state, h, shape: faces(at.x, at.y, h) };
	})
	.sort((p, q) => p.at.depth - q.at.depth || p.index - q.index);

// The gauge: a half dial from 0 to 100, with the audit's four bands.
const bands = [
	{ from: 0, to: 39, name: 'Not Ready' },
	{ from: 40, to: 69, name: 'Needs Work' },
	{ from: 70, to: 89, name: 'Nearly Ready' },
	{ from: 90, to: 100, name: 'Production Ready' },
];
const R = 88;
const C = { x: 110, y: 104 };
const point = (v: number, r = R) => {
	const t = Math.PI * (1 - v / 100);
	return { x: C.x + r * Math.cos(t), y: C.y - r * Math.sin(t) };
};
const arc = (from: number, to: number, r = R) => {
	const p = point(from, r);
	const q = point(to, r);
	return `M ${p.x.toFixed(1)} ${p.y.toFixed(1)} A ${r} ${r} 0 0 1 ${q.x.toFixed(1)} ${q.y.toFixed(1)}`;
};
const band = (v: number) => bands.find((b) => v >= b.from && v <= b.to)!.name;
const end = hero.end.score;
const tip = point(end, R - 20);
const fixed = hero.steps.length;
---

<figure class="instrument" data-hero>
	<div class="field-wrap">
		<svg
			class="field"
			viewBox={`0 0 ${size.width} ${size.height}`}
			role="img"
			aria-labelledby="field-title field-desc"
		>
			<title id="field-title">Replay of a real ProdPilot run</title>
			<desc id="field-desc">
				{`One pillar per rule for Node.js with Express, ${rules.length} in all. On the sample project node_express_insecure the audit starts at ${hero.start.score} out of 100 with ${hero.start.failing.length} rules failing, ${hero.start.critical.length} of them critical. As fixes are verified the pillars rise and turn green. The run ends at ${end} with ${hero.end.failing.join(', ')} still failing and the gate clear.`}
			</desc>
			<defs>
				{
					['verified', 'failed', 'checking'].map((state) => (
						<linearGradient id={`glass-${state}`} x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" class={`stop-${state}`} stop-opacity="0.55" />
							<stop offset="1" class={`stop-${state}`} stop-opacity="0.04" />
						</linearGradient>
					))
				}
				<radialGradient id="floor-glow" cx="0.5" cy="0.55" r="0.55">
					<stop offset="0" stop-color="#45d483" stop-opacity="0.12" />
					<stop offset="1" stop-color="#45d483" stop-opacity="0" />
				</radialGradient>
			</defs>
			<ellipse class="glow" cx={size.width / 2} cy={size.height * 0.62} rx={size.width * 0.52} ry={size.height * 0.34} fill="url(#floor-glow)" />
			{
				floor.map((t) => <polygon class="floor" points={t} />)
			}
			{
				pillars.map((p) => (
					<g class="pillar" data-state={p.state} data-rule={p.rule.id} data-weight={p.rule.weight} data-index={p.index}>
						<polygon class="left" points={p.shape.left} />
						<polygon class="right" points={p.shape.right} />
						<polygon class="top" points={p.shape.top} />
					</g>
				))
			}
		</svg>
		<ul class="legend" aria-label="Pillar states">
			<li><span class="light checking"></span>checking</li>
			<li><span class="light verified"></span>verified</li>
			<li><span class="light failed"></span>failed</li>
			<li><span class="light idle"></span>does not apply</li>
		</ul>
	</div>

	<div class="panel">
		<svg class="gauge" viewBox="0 0 220 126" role="img" aria-labelledby="gauge-title">
			<title id="gauge-title">{`Readiness score ${end} out of 100, ${band(end)}`}</title>
			{bands.map((b) => <path class="band" d={arc(b.from + 0.8, b.to - 0.8)} />)}
			<path class="reading" data-gauge-arc d={arc(0.01, end)} />
			{
				[0, 40, 70, 90, 100].map((v) => {
					const p = point(v, R + 12);
					return (
						<text class="tick" x={p.x} y={p.y + 3} text-anchor="middle">
							{v}
						</text>
					);
				})
			}
			<line class="needle" data-gauge-needle x1={C.x} y1={C.y} x2={tip.x.toFixed(1)} y2={tip.y.toFixed(1)} />
			<circle class="hub" cx={C.x} cy={C.y} r="4" />
		</svg>
		<div class="dial-text">
		<p class="score" aria-hidden="true">
			<span data-score>{end}</span><span class="of">/100</span>
		</p>
		<p class="band-name" data-band aria-hidden="true">{band(end)}</p>
		<p class="readout" data-readout aria-hidden="true">Gate clear. {fixed} rules turned green.</p>
		<button class="replay" type="button" data-replay hidden>Replay the run</button>
		</div>
	</div>

	<figcaption>
		A real run, replayed: the sample project <code>node_express_insecure</code> taken from
		{' '}{hero.start.score} to {end} by ProdPilot's fix loop, one pillar per rule.{' '}
		<a href="/docs/results/metrics/#one-run-in-detail">Read the recorded run</a>.
	</figcaption>
</figure>

<script>
	import hero from '../data/hero.json';
	import { box, faces, origin, tall, COLS, FLAT, IDLE, type State } from '../lib/iso';

	const root = document.querySelector<HTMLElement>('[data-hero]');
	const still = window.matchMedia('(prefers-reduced-motion: reduce)');

	if (root) {
		const size = box(hero.rules.length);
		const groups = new Map<string, SVGGElement>();
		root.querySelectorAll<SVGGElement>('.pillar').forEach((g) => groups.set(g.dataset.rule!, g));
		const scoreEl = root.querySelector<HTMLElement>('[data-score]')!;
		const bandEl = root.querySelector<HTMLElement>('[data-band]')!;
		const readout = root.querySelector<HTMLElement>('[data-readout]')!;
		const needle = root.querySelector<SVGLineElement>('[data-gauge-needle]')!;
		const reading = root.querySelector<SVGPathElement>('[data-gauge-arc]')!;
		const replay = root.querySelector<HTMLButtonElement>('[data-replay]')!;
		const byId = new Map(hero.rules.map((r, i) => [r.id, { ...r, index: i }]));
		const heights = new Map<string, number>();
		let running = 0;

		const bands: [number, string][] = [
			[90, 'Production Ready'],
			[70, 'Nearly Ready'],
			[40, 'Needs Work'],
			[0, 'Not Ready'],
		];
		const bandOf = (v: number) => bands.find(([floor]) => v >= floor)![1];

		const R = 88;
		const C = { x: 110, y: 104 };
		const point = (v: number, r = R) => {
			const t = Math.PI * (1 - v / 100);
			return { x: C.x + r * Math.cos(t), y: C.y - r * Math.sin(t) };
		};

		function dial(v: number, state: State) {
			const tip = point(v, R - 20);
			needle.setAttribute('x2', tip.x.toFixed(1));
			needle.setAttribute('y2', tip.y.toFixed(1));
			const p = point(0.01);
			const q = point(Math.max(v, 0.5));
			reading.setAttribute('d', `M ${p.x.toFixed(1)} ${p.y.toFixed(1)} A ${R} ${R} 0 0 1 ${q.x.toFixed(1)} ${q.y.toFixed(1)}`);
			root!.dataset.gate = state;
			scoreEl.textContent = String(Math.round(v));
			bandEl.textContent = bandOf(Math.round(v));
		}

		function draw(id: string, state: State, h: number) {
			const rule = byId.get(id)!;
			const g = groups.get(id)!;
			const at = origin(rule.index, size.rows);
			const shape = faces(at.x, at.y, h);
			const [left, right, top] = g.querySelectorAll('polygon');
			left.setAttribute('points', shape.left);
			right.setAttribute('points', shape.right);
			top.setAttribute('points', shape.top);
			g.dataset.state = state;
			heights.set(id, h);
		}

		function rise(id: string, state: State, to: number, ms: number, run: number) {
			return new Promise<void>((done) => {
				const from = heights.get(id) ?? FLAT;
				const start = performance.now();
				const tick = (now: number) => {
					if (run !== running) return done();
					const t = Math.min(1, (now - start) / ms);
					const e = 1 - Math.pow(1 - t, 3);
					draw(id, state, from + (to - from) * e);
					t < 1 ? requestAnimationFrame(tick) : done();
				};
				requestAnimationFrame(tick);
			});
		}

		function count(from: number, to: number, ms: number, run: number, state: State) {
			return new Promise<void>((done) => {
				const start = performance.now();
				const tick = (now: number) => {
					if (run !== running) return done();
					const t = Math.min(1, (now - start) / ms);
					dial(from + (to - from) * (1 - Math.pow(1 - t, 3)), state);
					t < 1 ? requestAnimationFrame(tick) : done();
				};
				requestAnimationFrame(tick);
			});
		}

		const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

		function reset() {
			const failing = new Set(hero.start.failing);
			const skipped = new Set(hero.start.skipped);
			for (const rule of hero.rules) {
				if (skipped.has(rule.id)) draw(rule.id, 'idle', IDLE);
				else if (failing.has(rule.id)) draw(rule.id, 'failed', FLAT);
				else draw(rule.id, 'verified', tall(rule.weight));
			}
			dial(hero.start.score, 'failed');
			readout.textContent = `Audit: ${hero.start.score}/100. ${hero.start.failing.length} rules failing, ${hero.start.critical.length} critical.`;
		}

		// After the replay the verified pillars keep moving in a slow wave, the way
		// glass catches light. The swing is small, so a pillar's height still reads
		// as its rule's weight. It pauses off screen and never runs under reduced
		// motion.
		let waving = false;
		let onScreen = true;
		let last = 0;
		const SWING = 5;

		function wave(now: number) {
			if (!waving) return;
			if (onScreen && !document.hidden && now - last > 33) {
				last = now;
				const t = now / 1000;
				for (const rule of hero.rules) {
					const g = groups.get(rule.id)!;
					if (g.dataset.state !== 'verified') continue;
					const i = byId.get(rule.id)!.index;
					const phase = ((i % COLS) + Math.floor(i / COLS)) * 0.62;
					draw(rule.id, 'verified', tall(rule.weight) + SWING * Math.sin(t * 0.85 - phase));
				}
			}
			requestAnimationFrame(wave);
		}

		function startWave() {
			if (still.matches || waving) return;
			waving = true;
			requestAnimationFrame(wave);
		}

		new IntersectionObserver((entries) => {
			onScreen = entries.some((e) => e.isIntersecting);
		}).observe(root);

		async function play() {
			waving = false;
			const run = ++running;
			replay.hidden = true;
			reset();
			await wait(1100);
			let score = hero.start.score;
			for (const step of hero.steps) {
				if (run !== running) return;
				const rule = byId.get(step.rule)!;
				readout.textContent = `Checking ${rule.id}: ${rule.text}`;
				await Promise.all([
					rise(rule.id, 'checking', FLAT + 6, 180, run),
					count(score, score, 1, run, 'checking'),
				]);
				await wait(170);
				await Promise.all([
					rise(rule.id, 'verified', tall(rule.weight), 420, run),
					count(score, step.score, 420, run, 'checking'),
				]);
				score = step.score;
			}
			if (run !== running) return;
			dial(hero.end.score, 'verified');
			readout.textContent = `Gate clear. ${hero.end.failing.length} rules still fail: ${hero.end.failing.join(', ')}.`;
			replay.hidden = false;
			startWave();
		}

		function settle() {
			running++;
			waving = false;
			for (const rule of hero.rules) {
				const state = hero.end.skipped.includes(rule.id)
					? 'idle'
					: hero.end.failing.includes(rule.id)
						? 'failed'
						: 'verified';
				draw(rule.id, state, state === 'verified' ? tall(rule.weight) : state === 'failed' ? FLAT : IDLE);
			}
			dial(hero.end.score, 'verified');
			readout.textContent = `Gate clear. ${hero.end.failing.length} rules still fail: ${hero.end.failing.join(', ')}.`;
			replay.hidden = still.matches;
		}

		replay.addEventListener('click', () => play());

		if (still.matches) {
			settle();
		} else {
			const seen = new IntersectionObserver(
				(entries) => {
					if (entries.some((e) => e.isIntersecting)) {
						seen.disconnect();
						play();
					}
				},
				{ threshold: 0.35 }
			);
			seen.observe(root);
		}
		still.addEventListener('change', () => (still.matches ? settle() : undefined));
	}
</script>
