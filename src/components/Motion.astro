---
// Scroll and motion for the landing page. Everything here is an enhancement:
// without a script, or with reduced motion requested, the page renders in its
// final state and scrolls natively.
---

<script>
	import Lenis from 'lenis';

	const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const root = document.documentElement;

	// ---- The dock: a header that appears once the hero has scrolled away ----
	const dock = document.querySelector<HTMLElement>('[data-dock]');
	const hero = document.querySelector<HTMLElement>('.hero');
	const progress = document.querySelector<HTMLElement>('[data-progress]');
	if (dock && hero) {
		new IntersectionObserver(
			([entry]) => {
				const shown = !entry.isIntersecting;
				dock.dataset.shown = String(shown);
				dock.inert = !shown;
			},
			{ threshold: 0, rootMargin: '-80px 0px 0px 0px' }
		).observe(hero);
	}

	// ---- The layer in view lights its band in the section drawing ----------
	const how = document.querySelector<HTMLElement>('#how');
	if (how) {
		const watch = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (e.isIntersecting) how.dataset.active = (e.target as HTMLElement).dataset.layer;
				}
			},
			{ rootMargin: '-45% 0px -45% 0px' }
		);
		how.querySelectorAll('[data-layer]').forEach((li) => watch.observe(li));
	}

	if (!still) {
		root.classList.add('motion');

		// ---- Smooth scrolling ------------------------------------------------
		const lenis = new Lenis({
			autoRaf: true,
			lerp: 0.085,
			anchors: { offset: -84 },
			allowNestedScroll: true,
			stopInertiaOnNavigate: true,
		});

		// ---- Reveals: each block rises into place, its parts in sequence -------
		const parts = document.querySelectorAll<HTMLElement>(
			[
				'.plate:not(.hero-side):not(.hero-stage) .head > *',
				'.checklist > li',
				'.layers > li',
				'.why > article',
				'.log > div',
				'.steps > li',
				'.ides tbody tr',
				'.limits > li',
				'.contact > li',
				'.plate > .more',
				'.section-drawing',
				'.live > :not(ol)',
			].join(',')
		);
		parts.forEach((el) => {
			const siblings = el.parentElement ? [...el.parentElement.children] : [el];
			el.style.setProperty('--i', String(Math.min(siblings.indexOf(el), 8)));
			el.dataset.reveal = '';
		});
		const reveal = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					e.target.classList.add('in');
					reveal.unobserve(e.target);
				}
			},
			{ rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
		);
		parts.forEach((el) => reveal.observe(el));

		// ---- Figures count up the first time they are seen --------------------
		const figures = document.querySelectorAll<HTMLElement>('.log .value:not(.demo)');
		const count = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					count.unobserve(e.target);
					const el = e.target as HTMLElement;
					const text = el.textContent ?? '';
					const target = Number(text.replace(/[^\d]/g, ''));
					const suffix = text.replace(/[\d,]/g, '');
					const grouped = text.includes(',');
					if (!target) continue;
					el.setAttribute('aria-label', text);
					const began = performance.now();
					const step = (now: number) => {
						const t = Math.min((now - began) / 1600, 1);
						const eased = 1 - Math.pow(1 - t, 4);
						const n = Math.round(target * eased);
						el.textContent = (grouped ? n.toLocaleString('en-US') : String(n)) + suffix;
						if (t < 1) requestAnimationFrame(step);
					};
					requestAnimationFrame(step);
				}
			},
			{ threshold: 0.6 }
		);
		figures.forEach((el) => count.observe(el));

		// ---- Scroll-linked: plates lift in, the hero eases away ---------------
		const plates = [...document.querySelectorAll<HTMLElement>('main > .plate')];
		const side = document.querySelector<HTMLElement>('.hero-copy');
		const stage = document.querySelector<HTMLElement>('.hero-stage .stage');
		const settled = new WeakSet<HTMLElement>();

		function frame({ scroll, limit }: { scroll: number; limit: number }) {
			const vh = window.innerHeight;
			if (progress) progress.style.transform = `scaleX(${limit ? scroll / limit : 0})`;

			for (const plate of plates) {
				if (settled.has(plate)) continue;
				const top = plate.getBoundingClientRect().top;
				const p = Math.min(Math.max((vh - top) / (vh * 0.45), 0), 1);
				if (p >= 1) {
					plate.style.transform = '';
					settled.add(plate);
				} else {
					const eased = 1 - Math.pow(1 - p, 3);
					plate.style.transform = `translateY(${(1 - eased) * 70}px) scale(${0.965 + 0.035 * eased})`;
				}
			}

			if (hero && scroll < hero.offsetHeight * 1.2) {
				const p = scroll / Math.max(hero.offsetHeight, 1);
				if (side) side.style.transform = `translateY(${p * -40}px)`;
				if (stage) stage.style.transform = `translateY(${p * 70}px) scale(${1 + p * 0.05})`;
			}
		}

		lenis.on('scroll', frame);
		frame({ scroll: window.scrollY, limit: document.documentElement.scrollHeight - window.innerHeight });
	}
</script>
