---
// Scroll and motion for the landing page.
//
// Nothing here hides, moves or rewrites content. Every section is complete in
// the HTML and fully visible with no script, with reduced motion, and in a
// full-page capture that never scrolls. What remains is motion that explains
// something or helps navigation: smooth scrolling, the dock once the hero has
// gone, its progress line, and the checklist rows being checked as they arrive.
---

<script>
	import Lenis from 'lenis';

	const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// ---- The dock: a header that appears once the hero has scrolled away ----
	const dock = document.querySelector<HTMLElement>('[data-dock]');
	const hero = document.querySelector<HTMLElement>('.hero');
	const progress = document.querySelector<HTMLElement>('[data-progress]');
	if (dock && hero) {
		new IntersectionObserver(
			([entry]) => {
				const shown = !entry.isIntersecting;
				dock.dataset.shown = String(shown);
				dock.inert = !shown;
			},
			{ threshold: 0, rootMargin: '-80px 0px 0px 0px' }
		).observe(hero);
	}

	if (!still) {
		document.documentElement.classList.add('motion');

		// ---- Smooth scrolling ------------------------------------------------
		const lenis = new Lenis({
			autoRaf: true,
			lerp: 0.085,
			anchors: { offset: -84 },
			allowNestedScroll: true,
			stopInertiaOnNavigate: true,
		});
		const update = ({ scroll, limit }: { scroll: number; limit: number }) => {
			if (progress) progress.style.transform = `scaleX(${limit ? scroll / limit : 0})`;
		};
		lenis.on('scroll', update);
		update({ scroll: window.scrollY, limit: document.documentElement.scrollHeight - window.innerHeight });

		// ---- Checklist rows are checked as they arrive -------------------------
		// Each row is "fails in production" in the HTML and stays that way. When a
		// row first comes into view it shows "checking" for a moment, then returns
		// to its real state, which is what the pre-flight check does.
		const rows = document.querySelectorAll<HTMLElement>('[data-checklist] .check');
		const seen = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					const row = e.target as HTMLElement;
					seen.unobserve(row);
					const real = row.dataset.state ?? 'failed';
					row.dataset.state = 'checking';
					setTimeout(() => (row.dataset.state = real), 700);
				}
			},
			{ threshold: 0.6 }
		);
		rows.forEach((row) => seen.observe(row));
	}
</script>
