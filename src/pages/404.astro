---
import Landing from '../layouts/Landing.astro';
import { pypi, repo } from '../site.mjs';
---

<Landing
	title="Page not found | ProdPilot"
	description="This address does not match any page on the ProdPilot site."
	noindex
>
	<header class="topbar">
		<a class="brand" href="/" aria-label="ProdPilot home">
			<img src="/favicon.svg" alt="" width="28" height="28" />
			<span>ProdPilot</span>
		</a>
		<nav aria-label="Main">
			<a href="/docs/getting-started/introduction/">Docs</a>
			<a href={repo}>GitHub</a>
			<a href={pypi}>PyPI</a>
		</nav>
	</header>

	<main id="main">
		<section class="lost">
			<p class="eyebrow">Error 404</p>
			<h1>No page at this address.</h1>
			<ol class="checklist">
				<li class="check" data-state="failed">
					<span class="light" aria-hidden="true"></span>
					<div>
						<h2>Route check</h2>
						<p>The address you followed does not match any page on this site.</p>
					</div>
					<span class="verdict"><span class="sr-only">Status: </span>not found</span>
				</li>
			</ol>
			<p>
				Start from the <a href="/">home page</a>, read the{' '}
				<a href="/docs/getting-started/introduction/">documentation</a>, or use its search.
			</p>
		</section>
	</main>
</Landing>
