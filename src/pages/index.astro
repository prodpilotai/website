---
import Landing from '../layouts/Landing.astro';
import Run from '../components/Run.astro';
import Command from '../components/Command.astro';
import LiveCheck from '../components/LiveCheck.astro';
import Motion from '../components/Motion.astro';
import reference from '../data/reference.json';
import { facts } from '../data/facts';
import { email, install, issues, license, mailto, pypi, repo, securityReport, siteUrl, team, topics } from '../site.mjs';

const percent = Math.round(reference.determinism_ratio * 100);
const grouped = (n: number) => n.toLocaleString('en-US');

const title = 'ProdPilot: the pre-flight checklist for AI-built web apps';
const description = `ProdPilot audits a Node.js with Express or React with Vite project against ${reference.rules} production rules, has your editor's own agent fix what fails, verifies every fix itself, and deploys to Render only what clears the gate.`;

const jsonLd = [
	{
		'@type': 'SoftwareApplication',
		name: 'ProdPilot',
		description,
		applicationCategory: 'DeveloperApplication',
		operatingSystem: 'Windows, macOS, Linux',
		softwareVersion: reference.version,
		license: 'https://opensource.org/licenses/MIT',
		downloadUrl: pypi,
		url: siteUrl,
		codeRepository: repo,
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		author: team.map((m) => ({ '@type': 'Person', name: m.name, url: m.url })),
	},
];

// The six failures, each one a rule in the catalog. The detail of each lives on
// the rule catalog page it links to.
const gap = [
	{ rule: 'SCR-002', anchor: 'secrets', title: 'An API key in the source' },
	{ rule: 'SEC-002', anchor: 'security', title: 'No security headers' },
	{ rule: 'ENV-002', anchor: 'environment', title: 'A hardcoded port' },
	{ rule: 'BLD-001', anchor: 'build', title: 'No Dockerfile' },
	{ rule: 'OBS-001', anchor: 'observability', title: 'No health check' },
	{ rule: 'BLD-003', anchor: 'build', title: 'No deploy pipeline' },
];

// One line per step; the docs page explains each.
const layers = [
	{ n: 0, name: 'Detect', text: 'Names your stack and loads its production blueprint.' },
	{ n: 1, name: 'Audit', text: 'Scores the project against its rules, from 0 to 100.' },
	{ n: 2, name: 'Fix', text: 'Your agent writes each fix. ProdPilot re-checks it.' },
	{ n: 3, name: 'Gate', text: 'Opens only at 90 or more, with no critical failure.' },
	{ n: 4, name: 'Ship', text: 'Deploys to Render, smoke tests it, wires CI/CD.' },
];

const proof = [
	{ channel: 'Rules', value: String(reference.rules), label: 'production rules checked', source: 'Rule catalog', href: '/docs/reference/rules/' },
	{
		channel: 'No model',
		value: `${percent}%`,
		label: `of rules fixed with no model writing code, ${reference.deterministic} of ${reference.rules}`,
		source: 'Metrics',
		href: '/docs/results/metrics/#determinism-ratio',
	},
	{
		channel: 'Deployments',
		value: String(facts.deployments.total),
		label: "real Render deployments behind the gate's model",
		source: 'Evaluation',
		href: facts.deployments.source,
	},
	{
		channel: 'Tests',
		value: grouped(facts.tests.collected),
		label: 'tests at 1.0.0; the suite passes on Linux, macOS and Windows',
		source: 'Contributing',
		href: facts.tests.source,
	},
];

// The limits that matter most before you install. All of them are on the
// known limitations page.
const limits = [
	{ title: 'Two stacks.', text: 'Node.js with Express, and React with Vite.' },
	{ title: 'One deploy target.', text: 'Render.' },
	{ title: 'Six fixes are written by your agent.', text: 'How often they pass first time is not yet measured.' },
	{ title: 'Not yet seen on a live service:', text: 'a deploy started by an agent, or the CI workflow 1.0.0 writes.' },
	{ title: 'It needs your machine:', text: 'Docker, Node.js 20 or later, git, a GitHub token and a Render API key.' },
];
---

<Landing title={title} description={description} jsonLd={jsonLd}>
	<header class="dock" data-dock data-shown="false" inert>
		<a class="brand" href="/" aria-label="ProdPilot home">
			<svg viewBox="0 0 64 64" aria-hidden="true"><use href="#mark" /></svg>
			<span>ProdPilot</span>
		</a>
		<nav aria-label="Sections">
			<a href="#how">How it works</a>
			<a href="#proof">Proof</a>
			<a href="#limits">Limits</a>
			<a href="#start">Get started</a>
		</nav>
		<a class="button solid" href="/docs/getting-started/introduction/">Docs</a>
		<span class="dock-progress" data-progress aria-hidden="true"></span>
	</header>

	<main id="main">
		<section class="hero" aria-labelledby="hero-title">
			<div class="plate stone hero-side">
				<header class="hero-bar">
					<a class="brand" href="/" aria-label="ProdPilot home">
						<svg viewBox="0 0 64 64" aria-hidden="true"><use href="#mark" /></svg>
						<span>ProdPilot</span>
					</a>
					<nav class="hero-nav" aria-label="Main">
						<a href="#how">How it works</a>
						<a href="#proof">Proof</a>
						<a href="#start">Get started</a>
						<a href="/docs/getting-started/introduction/">Docs</a>
						<a href={repo}>GitHub</a>
					</nav>
				</header>

				<div class="hero-copy">
					<p class="label">For Node.js with Express and React with Vite</p>
					<h1 id="hero-title">It works on localhost. <em>That was never the question.</em></h1>
					<p class="sub">
						Audit your AI-built app against {reference.rules} production rules, fix it with the agent already in your
						editor, and deploy only what passes.
					</p>
					<Command command={install} label="Copy the install command" />
					<div class="actions">
						<a class="button solid" href="/docs/getting-started/quickstart/">Start the quickstart <span aria-hidden="true">&rarr;</span></a>
						<a class="button" href={repo}>View on GitHub</a>
					</div>
				</div>
			</div>

			<div class="plate night hero-stage">
				<Run />
			</div>
		</section>

		<section class="plate stone" id="gap" aria-labelledby="gap-title">
			<header class="head center">
				<p class="label">The gap</p>
				<h2 id="gap-title">Six things localhost never checks</h2>
				<p class="intro">Your laptop fills them in. A real server does not.</p>
			</header>
			<ul class="tiles">
				{
					gap.map((g) => (
						<li data-state="failed">
							<span class="box" aria-hidden="true" />
							<h3>{g.title}</h3>
							<p>
								<span class="sr-only">Fails in production. Rule </span>
								<a href={`/docs/reference/rules/#${g.anchor}`}>{g.rule}</a>
							</p>
						</li>
					))
				}
			</ul>
		</section>

		<section class="plate night" id="how" aria-labelledby="path-title">
			<header class="head center">
				<p class="label">How it works</p>
				<h2 id="path-title">Five steps, always in this order</h2>
			</header>
			<ol class="sequence">
				{
					layers.map((l) => (
						<li>
							<span class="node" aria-hidden="true">{l.n}</span>
							<h3>
								<span class="sr-only">Step {l.n}: </span>
								{l.name}
							</h3>
							<p>{l.text}</p>
						</li>
					))
				}
			</ol>
			<p class="more center"><a href="/docs/concepts/five-layers/">How each step works</a></p>
		</section>

		<section class="plate night" id="proof" aria-labelledby="log-title">
			<header class="head center">
				<p class="label">Proof</p>
				<h2 id="log-title">Measured, not claimed</h2>
				<p class="intro">Every figure links to where it was measured.</p>
			</header>
			<dl class="log">
				{
					proof.map((p) => (
						<div>
							<dt>{p.label}</dt>
							<dd class="value"><span class="channel" aria-hidden="true">{p.channel}</span>{p.value}</dd>
							<dd class="source"><a href={p.href}>Source: {p.source}</a></dd>
						</div>
					))
				}
			</dl>
			<div class="trust">
				<p class="editors">
					<span class="label">Verified in</span>
					<a href="/docs/getting-started/vscode/">VS Code</a>
					<a href="/docs/getting-started/cursor/">Cursor</a>
					<a href="/docs/getting-started/windsurf/">Windsurf, now Devin</a>
					<a class="source" href={facts.ides.source}>Compatibility record</a>
				</p>
				<LiveCheck />
			</div>
		</section>

		<section class="plate stone" id="limits" aria-labelledby="limits-title">
			<header class="head center">
				<p class="label">Honest limits</p>
				<h2 id="limits-title">What it does not do</h2>
			</header>
			<ul class="limits">
				{limits.map((l) => <li><strong>{l.title}</strong> {l.text}</li>)}
			</ul>
			<p class="more center"><a href="/docs/help/limitations/">All known limitations</a></p>
		</section>

		<section class="plate night" id="start" aria-labelledby="start-title">
			<div class="start">
				<div>
					<header class="head">
						<p class="label">Get started</p>
						<h2 id="start-title">Three commands</h2>
					</header>
					<ol class="commands">
						<li><Command command={install} label="Copy the install command" /></li>
						<li><Command command="prodpilot setup" label="Copy the setup command" /></li>
						<li><Command command="prodpilot connect vscode" label="Copy the connect command" /></li>
					</ol>
					<p class="fine">
						Or <code>connect cursor</code>, or <code>connect devin --project PATH</code>. Then ask your agent to audit
						the project. <a href="/docs/getting-started/quickstart/">Quickstart</a>
					</p>
				</div>
				<figure class="terminal">
					<div class="terminal-bar" aria-hidden="true"><span></span><span></span><span></span><code>prodpilot doctor</code></div>
					<pre><code><span class="prompt">$</span> prodpilot doctor
ProdPilot doctor

Config file: ~/.prodpilot/config.toml
  <span class="ok">found</span>
  github_token: <span class="ok">stored</span>
  render_api_key: <span class="ok">stored</span>
  permissions: access is limited to the current user

Tools ProdPilot runs:
  git: git version 2.54.0.windows.1
  Node.js: v26.3.0
  Docker: daemon 29.7.2

<span class="ok">All checks passed.</span></code></pre>
					<figcaption>Real output, ProdPilot {reference.version}, 25 September 2026. Home directory shown as <code>~</code>.</figcaption>
				</figure>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="footer-lead">
			<p class="tagline">Cleared for <em>production.</em></p>
			<div class="footer-cta">
				<p>From localhost to live, with every fix checked on the way.</p>
				<Command command={install} label="Copy the install command" />
				<div class="actions">
					<a class="button solid" href="/docs/getting-started/quickstart/">Start the quickstart <span aria-hidden="true">&rarr;</span></a>
					<a class="button" href={repo}>Star it on GitHub</a>
				</div>
			</div>
		</div>

		<nav class="footer-grid" aria-label="Footer">
			<div>
				<p class="label">Product</p>
				<ul>
					<li><a href="/docs/getting-started/introduction/">Documentation</a></li>
					<li><a href="/docs/getting-started/quickstart/">Quickstart</a></li>
					<li><a href="/docs/reference/rules/">Rule catalog</a></li>
					<li><a href="/docs/help/changelog/">Changelog</a></li>
				</ul>
			</div>
			<div>
				<p class="label">Open source</p>
				<ul>
					<li><a href={repo}>GitHub repository <span class="path">prodpilotai/ProdPilot</span></a></li>
					<li><a href={pypi}>PyPI package</a></li>
					<li><a href={issues}>Issues</a></li>
					<li><a href={securityReport}>Report a vulnerability</a></li>
					<li><a href={license}>MIT License</a></li>
				</ul>
			</div>
			<div>
				<p class="label">Team</p>
				<ul>
					{
						team.map((m) => (
							<li>
								<a href={m.url} rel="author">{m.name}<svg class="out" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 8.5l5-5M4.5 3.5h4v4" /></svg></a>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<p class="label">Contact</p>
				<ul>
					<li><a href={`mailto:${email}`}>{email}</a></li>
					{topics.map((t) => <li><a href={mailto(t.subject)}>{t.label}</a></li>)}
				</ul>
			</div>
		</nav>

		<p class="wordmark" aria-hidden="true">ProdPilot</p>

		<div class="footer-base">
			<a class="brand" href="/" aria-label="ProdPilot home">
				<svg viewBox="0 0 64 64" aria-hidden="true"><use href="#mark" /></svg>
				<span>ProdPilot {reference.version}</span>
			</a>
			<p>Open source under the MIT license. Built by the ProdPilot team.</p>
			<a class="top" href="#main">Back to top</a>
		</div>
	</footer>

	<svg width="0" height="0" class="sr-only" aria-hidden="true">
		<symbol id="mark" viewBox="0 0 64 64">
			<circle cx="32" cy="32" r="19" fill="none" stroke="currentColor" stroke-width="3.5" />
			<path d="M22.5 32.5l6.5 6.5 12.5-13.5" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
			<circle cx="47.5" cy="16.5" r="3.6" fill="#b86e12" />
		</symbol>
	</svg>
	<Motion />
</Landing>
