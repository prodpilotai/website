---
import Landing from '../layouts/Landing.astro';
import Stage from '../components/Stage.astro';
import Command from '../components/Command.astro';
import LiveCheck from '../components/LiveCheck.astro';
import reference from '../data/reference.json';
import { facts } from '../data/facts';
import { demo, email, install, issues, license, pypi, repo, securityReport, siteUrl, team } from '../site.mjs';

const percent = Math.round(reference.determinism_ratio * 100);
const grouped = (n: number) => n.toLocaleString('en-US');

const title = 'ProdPilot: the pre-flight checklist for AI-built web apps';
const description = `ProdPilot audits a Node.js with Express or React with Vite project against ${reference.rules} production rules, has your editor's own agent fix what fails, verifies every fix itself, and deploys to Render only what clears the gate.`;

const jsonLd = [
	{
		'@type': 'SoftwareApplication',
		name: 'ProdPilot',
		description,
		applicationCategory: 'DeveloperApplication',
		operatingSystem: 'Windows, macOS, Linux',
		softwareVersion: reference.version,
		license: 'https://opensource.org/licenses/MIT',
		downloadUrl: pypi,
		url: siteUrl,
		codeRepository: repo,
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		author: team.map((name) => ({ '@type': 'Person', name })),
	},
];

// The six failures, each one a rule in the catalog.
const gap = [
	{
		rule: 'SCR-002',
		anchor: 'secrets',
		priority: 'P0',
		title: 'An API key written into the source',
		detail: 'Anyone who can read the repository can read the key, and it stays in the Git history after you delete it.',
	},
	{
		rule: 'SEC-002',
		anchor: 'security',
		priority: 'P0',
		title: 'No security headers',
		detail: 'Helmet is not registered before the routes, so every response goes out without them.',
	},
	{
		rule: 'ENV-002',
		anchor: 'environment',
		priority: 'P0',
		title: 'A hardcoded port',
		detail: 'The host decides which port the app listens on. Code that picks its own is guessing.',
	},
	{
		rule: 'BLD-001',
		anchor: 'build',
		priority: 'P1',
		title: 'No Dockerfile',
		detail: 'Nothing says how to build and start the app anywhere except the machine it was written on.',
	},
	{
		rule: 'OBS-001',
		anchor: 'observability',
		priority: 'P4',
		title: 'No health check',
		detail: 'The platform cannot tell a service that is running from one that is stuck.',
	},
	{
		rule: 'BLD-003',
		anchor: 'build',
		priority: 'P1',
		title: 'No pipeline',
		detail: 'Every deploy is a manual push, and nothing runs before it reaches users.',
	},
];

const layers = [
	{
		n: 0,
		name: 'Detect',
		text: 'Reads package.json and the file tree, names the stack, and loads its production blueprint. An ambiguous project is refused, not guessed.',
	},
	{
		n: 1,
		name: 'Audit',
		text: `Checks ${reference.by_stack.node_express} rules for Express or ${reference.by_stack.react_vite} for React, and scores the project from 0 to 100.`,
	},
	{
		n: 2,
		name: 'Fix',
		text: "Hands your editor's agent one fix at a time, then runs that rule's own checker again to see whether it worked.",
	},
	{
		n: 3,
		name: 'Gate',
		text: 'Opens only at a score of 90 or more, with no critical rule failing, and a deployability estimate at or above its operating point.',
	},
	{
		n: 4,
		name: 'ProdPush',
		text: 'Builds in Docker on your machine, pushes, deploys to Render, smoke tests the live service and wires a GitHub Actions pipeline.',
	},
];

// The section drawing beside the layers: the hero's pyramid cut through, one
// band per layer, Detect at the base.
const BAND = 44;
const BASE = 300;
const drawing = layers.map((l) => {
	const y1 = 250 - l.n * BAND;
	const y0 = y1 - BAND;
	const half = (y: number) => (BASE / 2) * ((y - 30) / 220);
	return {
		...l,
		points: `${160 - half(y1)},${y1} ${160 + half(y1)},${y1} ${160 + half(y0)},${y0} ${160 - half(y0)},${y0}`,
		label: y1 - BAND / 2 + 4,
	};
});

const proof = [
	{ value: String(reference.rules), label: 'Production rules checked', source: 'Rule catalog', href: '/docs/reference/rules/' },
	{
		value: `${percent}%`,
		label: `Rules fixed with no model writing anything: ${reference.deterministic} of ${reference.rules}`,
		source: 'Metrics',
		href: '/docs/results/metrics/#determinism-ratio',
	},
	{
		value: String(facts.deployments.total),
		label: `Real Render deployments behind the gate's model, of which ${facts.deployments.live} went live`,
		source: 'Evaluation',
		href: facts.deployments.source,
	},
	{
		value: String(facts.ides.count),
		label: 'IDEs verified with all five tools and both contract forms',
		source: 'Compatibility matrix',
		href: facts.ides.source,
	},
	{
		value: grouped(facts.tests.collected),
		label: `Automated tests at version ${reference.version}, passing on Linux, macOS and Windows`,
		source: 'Contributing',
		href: facts.tests.source,
	},
];
---

<Landing title={title} description={description} jsonLd={jsonLd}>
	<main id="main">
		<section class="hero" aria-labelledby="hero-title">
			<div class="plate stone hero-side">
				<a class="brand" href="/" aria-label="ProdPilot home">
					<svg viewBox="0 0 64 64" aria-hidden="true"><use href="#mark" /></svg>
					<span>ProdPilot</span>
				</a>

				<svg class="construction" viewBox="0 0 64 64" aria-hidden="true">
					<g class="guides">
						<path pathLength="1" d="M-40 13H104M-40 51H104M13 -40V104M51 -40V104M-40 32H104M32 -40V104" />
						<path pathLength="1" d="M-8 -8L72 72M72 -8L-8 72" />
						<circle pathLength="1" cx="32" cy="32" r="26" />
						<circle pathLength="1" cx="32" cy="32" r="12.5" />
						<circle pathLength="1" cx="47.5" cy="16.5" r="6" />
					</g>
					<g class="figure">
						<circle pathLength="1" cx="32" cy="32" r="19" />
						<path pathLength="1" d="M22.5 32.5l6.5 6.5 12.5-13.5" />
						<circle class="pip" cx="47.5" cy="16.5" r="3.2" />
					</g>
				</svg>

				<div class="hero-copy">
					<p class="label">Pre-flight for Node.js with Express and React with Vite</p>
					<h1 id="hero-title">It works on localhost. <em>That was never the question.</em></h1>
					<Command command={install} label="Copy the install command" />
				</div>
			</div>

			<div class="plate night hero-stage">
				<nav class="stage-nav" aria-label="Main">
					<a href="#how">How it works</a>
					<a href="#proof">Proof</a>
					<a href="#live">Live check</a>
					<a href="/docs/getting-started/introduction/">Docs</a>
					<a href={repo}>GitHub</a>
					<a href={pypi}>PyPI</a>
				</nav>
				<Stage />
				<div class="stage-foot">
					<p class="lede">
						ProdPilot is the pre-flight checklist your AI agent never ran: it audits your project against
						{' '}{reference.rules} production rules, has your editor's agent fix what fails, checks every fix
						itself, and deploys only what clears the gate.
					</p>
					<div class="actions">
						<a class="button solid" href="/docs/getting-started/introduction/">Read the docs <span aria-hidden="true">&rarr;</span></a>
						<a class="button" href={repo}>View on GitHub</a>
					</div>
				</div>
			</div>
		</section>

		<section class="plate stone" id="gap" aria-labelledby="gap-title">
			<div class="split">
				<header class="head">
					<p class="label">The gap</p>
					<h2 id="gap-title">Six things localhost never checks</h2>
					<p class="intro">
						You build fast with AI tools, and the code works. What nobody checks is the layer underneath it: the
						part your laptop fills in without asking. A real server fills in none of it. Each of these is a rule
						ProdPilot checks.
					</p>
				</header>
				<ol class="checklist ledger" data-checklist>
					{
						gap.map((g) => (
							<li class="check" data-state="failed">
								<span class="light" aria-hidden="true" />
								<div>
									<h3>{g.title}</h3>
									<p>{g.detail}</p>
								</div>
								<a class="rule" href={`/docs/reference/rules/#${g.anchor}`}>
									{g.rule} <span class="prio">{g.priority}</span>
								</a>
								<span class="verdict">
									<span class="when-failed">
										<span class="sr-only">Status: </span>fails in production
									</span>
									<span class="when-checking" aria-hidden="true">checking</span>
								</span>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="plate night" id="how" aria-labelledby="path-title">
			<div class="split">
				<header class="head">
					<p class="label">How it works</p>
					<h2 id="path-title">Five layers, built from the ground up</h2>
					<p class="intro">
						Always in this order. Nothing moves to the next layer until the one below it holds.
					</p>
					<svg class="section-drawing" viewBox="0 0 320 262" aria-hidden="true">
						<line class="floor" x1="0" y1="250.5" x2="320" y2="250.5" />
						{
							drawing.map((d) => (
								<g class={`band band-${d.n}`}>
									<polygon points={d.points} />
									<text x="160" y={d.label} text-anchor="middle">{d.n}</text>
								</g>
							))
						}
					</svg>
				</header>
				<ol class="layers">
					{
						[...layers].reverse().map((l) => (
							<li data-layer={l.n}>
								<span class="num" aria-hidden="true">{l.n}</span>
								<div>
									<h3>
										<span class="sr-only">Layer {l.n}: </span>
										{l.name}
									</h3>
									<p>{l.text}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
			<p class="more"><a href="/docs/concepts/five-layers/">The five layers in detail</a></p>
		</section>

		<section class="plate stone" id="why" aria-labelledby="why-title">
			<header class="head wide">
				<p class="label">Why it is different</p>
				<h2 id="why-title">Nothing ships on trust</h2>
			</header>
			<div class="why">
				<article>
					<p class="figure-note">No AI service called</p>
					<h3>It runs no model of its own</h3>
					<p>
						The agent already in your editor does the writing. ProdPilot decides what to write and whether it
						worked.
					</p>
					<a href="/docs/concepts/security/#what-leaves-your-machine">What leaves your machine</a>
				</article>
				<article>
					<p class="big" aria-hidden="true">{percent}<span>%</span></p>
					<h3>{percent} percent of fixes need no model at all</h3>
					<p>
						{reference.deterministic} of the {reference.rules} rules come with the exact change to make, either fixed
						in advance or computed from values read out of your project. Only {reference.by_fix_type['DYNAMIC-DELEGATED']}{' '}
						ask the agent to write code, inside limits ProdPilot sets.
					</p>
					<a href="/docs/concepts/fix-types/">Fix types</a>
				</article>
				<article>
					<p class="figure-note">Every fix re-verified</p>
					<h3>It never takes the agent's word</h3>
					<p>
						When the agent reports a fix, the report is set aside. The rule's own checker runs again on the files
						on disk and decides. A fix that breaks a rule that passed before it is undone.
					</p>
					<a href="/docs/concepts/verification/">Independent verification</a>
				</article>
			</div>
		</section>

		<section class="plate night" id="proof" aria-labelledby="log-title">
			<header class="head wide">
				<p class="label">Proof</p>
				<h2 id="log-title">The flight log</h2>
				<p class="intro">Every figure links to the page where it was measured.</p>
			</header>
			<dl class="log">
				{
					proof.map((p) => (
						<div>
							<dt>{p.label}</dt>
							<dd class="value">{p.value}</dd>
							<dd class="source"><a href={p.href}>{p.source}</a></dd>
						</div>
					))
				}
				<div>
					<dt>Live demo, deployed by ProdPilot</dt>
					<dd class="value demo"><a href={demo}>prodpilot-demo.onrender.com</a></dd>
					<dd class="source"><a href="/docs/getting-started/introduction/#see-it-running">About the demo</a></dd>
				</div>
			</dl>
		</section>

		<section class="plate stone" id="live" aria-labelledby="live-title">
			<div class="split">
				<header class="head">
					<p class="label">Live check</p>
					<h2 id="live-title">The demo, checked from your browser</h2>
					<p class="intro">
						A small Express API that ProdPilot audited, fixed and deployed to Render. Your browser asks it three
						of the questions the <a href="/docs/prodpush/smoke-test/">post-deploy smoke test</a> asks every
						deployment, right now.
					</p>
				</header>
				<LiveCheck />
			</div>
		</section>

		<section class="plate night" id="works" aria-labelledby="ide-title">
			<header class="head wide">
				<p class="label">Works with</p>
				<h2 id="ide-title">Three editors, verified</h2>
				<p class="intro">
					Recorded in each editor on 14 September 2026. They all run the same five tools. What differs is how each
					one is set up and when it asks before a tool runs.
				</p>
			</header>
			<table class="ides">
				<thead>
					<tr>
						<th scope="col">Editor</th>
						<th scope="col">Version tested</th>
						<th scope="col">Connect it with</th>
						<th scope="col">Asks before a tool runs</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<th scope="row"><a href="/docs/getting-started/vscode/">VS Code, GitHub Copilot agent</a></th>
						<td>1.137.0</td>
						<td><code>prodpilot connect vscode</code></td>
						<td>Before each tool's first call; can be allowed for the session</td>
					</tr>
					<tr>
						<th scope="row"><a href="/docs/getting-started/cursor/">Cursor, Agent</a></th>
						<td>3.20.17</td>
						<td><code>prodpilot connect cursor</code></td>
						<td>Not on its fresh install default</td>
					</tr>
					<tr>
						<th scope="row"><a href="/docs/getting-started/windsurf/">Windsurf, now Devin</a></th>
						<td>3.10.23</td>
						<td><code>prodpilot connect devin --project PATH</code></td>
						<td>Before every call</td>
					</tr>
				</tbody>
			</table>
			<p class="more">
				Windsurf is now distributed as Devin, and it cannot start ProdPilot from the configuration VS Code and
				Cursor use, so it gets a file of its own. <a href="/docs/results/compatibility/">Full compatibility record</a>
			</p>
		</section>

		<section class="plate stone" id="limits" aria-labelledby="limits-title">
			<div class="split">
				<header class="head">
					<p class="label">Honest limits</p>
					<h2 id="limits-title">What it does not do</h2>
					<p class="more"><a href="/docs/help/limitations/">All known limitations</a></p>
				</header>
				<ul class="limits">
					<li>
						<strong>Two stacks.</strong> Node.js with Express, and React with Vite. Anything else is reported as
						unrecognized rather than guessed.
					</li>
					<li><strong>One provider.</strong> Render is the only deployment target.</li>
					<li>
						<strong>Six fixes are written by your agent.</strong> ProdPilot verifies each one, but how often a live
						agent's change passes on the first try has not been measured yet.
					</li>
					<li>
						<strong>Your editor decides when to ask.</strong> On Cursor's fresh install default nothing in the
						editor stops the agent calling the deploy tool; only the tool's own instruction asks it to confirm
						with you.
					</li>
					<li>
						<strong>Not yet observed end to end on a live service:</strong> a deploy started by an IDE agent, and
						the generated workflow redeploying from GitHub Actions.
					</li>
					<li>
						<strong>It needs your machine.</strong> Docker running, Node.js 20 or later, git, a GitHub token and a
						Render API key.
					</li>
				</ul>
			</div>
		</section>

		<section class="plate night" id="start" aria-labelledby="start-title">
			<header class="head wide">
				<p class="label">Get started</p>
				<h2 id="start-title">Three commands</h2>
			</header>
			<ol class="steps">
				<li>
					<h3>Install</h3>
					<Command command={install} label="Copy the install command" />
					<p class="fine">Free and open source under the MIT license. Python 3.11 to 3.14.</p>
				</li>
				<li>
					<h3>Store your GitHub token and Render API key</h3>
					<Command command="prodpilot setup" label="Copy the setup command" />
				</li>
				<li>
					<h3>Register it with your editor</h3>
					<Command command="prodpilot connect vscode" label="Copy the connect command" />
					<p class="fine">Or <code>cursor</code>, or <code>devin --project PATH</code>.</p>
				</li>
			</ol>
			<p class="more">
				Then run <code>prodpilot doctor</code> and ask your agent: "Use ProdPilot to audit this project and fix what
				it reports, one rule at a time." <a href="/docs/getting-started/quickstart/">Quickstart</a>
			</p>
		</section>

		<section class="plate stone" id="contact" aria-labelledby="contact-title">
			<div class="split">
				<header class="head">
					<p class="label">Contact</p>
					<h2 id="contact-title">Questions, bugs and security reports</h2>
				</header>
				<ul class="contact">
					<li><span class="label">Email</span> <a href={`mailto:${email}`}>{email}</a></li>
					<li><span class="label">Bugs and requests</span> <a href={issues}>GitHub Issues</a></li>
					<li>
						<span class="label">Security</span> Report a vulnerability privately through the repository's
						{' '}<a href={securityReport}>Security tab</a>, never in a public issue.
					</li>
				</ul>
			</div>
		</section>
	</main>

	<footer class="footer">
		<nav aria-label="Footer">
			<a href={repo}>GitHub</a>
			<a href={pypi}>PyPI</a>
			<a href="/docs/getting-started/introduction/">Docs</a>
			<a href={`mailto:${email}`}>Contact</a>
			<a href={license}>MIT License</a>
		</nav>
		<p>Built by {team.slice(0, -1).join(', ')} and {team.at(-1)}.</p>
		<p class="fine">ProdPilot {reference.version}</p>
	</footer>

	<svg width="0" height="0" class="sr-only" aria-hidden="true">
		<symbol id="mark" viewBox="0 0 64 64">
			<circle cx="32" cy="32" r="19" fill="none" stroke="currentColor" stroke-width="3.5" />
			<path d="M22.5 32.5l6.5 6.5 12.5-13.5" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
			<circle cx="47.5" cy="16.5" r="3.6" fill="#b86e12" />
		</symbol>
	</svg>
</Landing>

<script>
	// The gap checklist settles row by row as it scrolls into view: each rule is
	// checked, amber, then shown failing, red.
	// Rows render failing, which is the truth with or without this script. Rows
	// still below the fold are set to checking so they settle as they arrive.
	const rows = document.querySelectorAll<HTMLElement>('[data-checklist] .check');
	const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (!still && 'IntersectionObserver' in window) {
		rows.forEach((row) => {
			if (row.getBoundingClientRect().top > window.innerHeight) row.dataset.state = 'checking';
		});
		const seen = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					const row = entry.target as HTMLElement;
					seen.unobserve(row);
					setTimeout(() => (row.dataset.state = 'failed'), 650);
				});
			},
			{ threshold: 0.6 }
		);
		rows.forEach((row) => seen.observe(row));
	}
</script>
